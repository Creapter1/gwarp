+<script id="gw-v1570-smooth">
+/* v15.70.0 (Claude): S4 smooth motion + live sprite info while a project runs.
+   Smooth motion = drawing only. Scripts step at the project's frame rate exactly as before; on the screen frames
+   in between, sprites are drawn part-way from where they were to where they are now (same rules as TurboWarp:
+   only small moves, same costume, sprite visible both times). Off by default: More > Advanced settings. */
+(() => { 'use strict';
+  const GW = window.GW, E = window.Engine; if (!GW || !E || GW.smoothFrame) return;
+  const on = () => !!window.GW_SETTINGS?.smoothOn?.() && E.isRunning && !E.isPaused;
+  let prev = new Map(), stepT = 0, iv = 0, live = 0;
+  const snap = s => ({ x: s.x, y: s.y, d: s.direction, z: s.size, c: s.activeCostume, v: s.visible });
+  function drawAt(t, draw) {
+    const saved = [];
+    for (const s of E.sprites) { const p = prev.get(s); if (!p || !p.v || !s.visible || p.c !== s.activeCostume) continue;
+      const x = s.x, y = s.y, d = s.direction, z = s.size, k = 1 - t; let ch = false;
+      if ((p.x !== x || p.y !== y) && Math.abs(x - p.x) < 50 && Math.abs(y - p.y) < 50) { s.x = x - (x - p.x) * k; s.y = y - (y - p.y) * k; ch = true; }
+      if (p.d !== d && isFinite(p.d) && isFinite(d)) { let dd = ((d - p.d + 540) % 360) - 180; if (Math.abs(dd) < 90) { s.direction = d - dd * k; ch = true; } }
+      if (p.z !== z && p.z > 0 && z > 0) { s.size = z - (z - p.z) * k; ch = true; }
+      if (ch) saved.push([s, x, y, d, z]); }
+    try { draw(); } finally { for (const [s, x, y, d, z] of saved) { s.x = x; s.y = y; s.direction = d; s.size = z; } }
+  }
+  GW.smoothBefore = now => { if (!on()) { if (prev.size) prev = new Map(); return; } const m = new Map(); for (const s of E.sprites) m.set(s, snap(s)); prev = m; };
+  GW.smoothAfter = (now, draw) => {
+    if (E.isRunning && now - live > 100) { live = now; const a = document.activeElement, id = a && a.id; if (!/^prop(X|Y|Size|Direction)$/.test(id || '')) { try { window.updatePropertyInputs?.(); } catch {} } }
+    if (!on() || !prev.size) return draw(); stepT = now; iv = window.GW_SETTINGS.stepMs() || 0; if (!iv) return draw(); drawAt(0, draw); };
+  GW.smoothFrame = (now, draw) => { if (!on() || !prev.size || !iv) return; drawAt(Math.min(1, (now - stepT) / iv), draw); };
+})();
+</script>
